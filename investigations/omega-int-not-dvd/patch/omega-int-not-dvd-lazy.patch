+/-- For `h : ¬ (k : Int) ∣ x` with `k` a nonzero literal, return a proof of `0 < x % k`. -/
+def notDvdLit? (h P : Expr) : MetaM (Option Expr) := do
+  let_expr Dvd.dvd α _ k x := (← whnfR P) | return none
+  let_expr Int := α | return none
+  let some k' := groundInt? k | return none
+  if k' = 0 then return none
+  let w := mkApp2 (.const ``Eq.refl [1]) (.const ``Bool []) (.const ``Bool.true [])
+  return some (mkApp4 (.const ``Int.emod_pos_of_not_dvd_of_bne []) k x w h)
+
