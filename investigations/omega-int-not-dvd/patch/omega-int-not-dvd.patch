+++ b/src/Init/Omega/Int.lean	2026-10-23 19:53:55.018912523 -0600
@@ -62,6 +62,10 @@
 theorem emod_ofNat_nonneg {x : Nat} {y : Int} : 0 ≤ (x : Int) % y :=
   Int.natCast_nonneg _
 
+theorem emod_pos_of_not_dvd_of_bne {a b : Int} (w : (a != 0) = true) (h : ¬ a ∣ b) :
+    0 < b % a :=
+  (Int.emod_pos_of_not_dvd h).resolve_left fun h0 => by simp [h0] at w
+
 -- FIXME these are insane:
 theorem lt_of_not_ge {x y : Int} (h : ¬ (x ≤ y)) : y < x := Int.not_le.mp h
 theorem lt_of_not_le {x y : Int} (h : ¬ (x ≤ y)) : y < x := Int.not_le.mp h
